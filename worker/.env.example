# Cloudflare R2 credentials (for upload script)
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket names (update these to match your actual R2 bucket names)
R2_CLASSROOM_BUCKET=harby
